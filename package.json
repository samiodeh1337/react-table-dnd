{
  "name": "react-table-dnd",
  "version": "3.0.0",
  "type": "module",
  "description": "Drag-and-drop rows and columns for React tables: multi-select group drag, virtual lists, touch, no dependencies",
  "main": "dist/index.cjs",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "style": "./dist/react-table-dnd.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/react-table-dnd.css"
    },
    "./dist/react-table-dnd.css": "./dist/react-table-dnd.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b && vite build && node scripts/finish-build.mjs",
    "dev": "vite --config vite.config.docs.ts",
    "build:docs": "tsc -p tsconfig.docs.json --noEmit && vite build --config vite.config.docs.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "keywords": [
    "react",
    "table",
    "sortable",
    "draggable",
    "drag-and-drop",
    "dnd",
    "draggable table",
    "draggable rows",
    "draggable columns",
    "react table",
    "data grid",
    "row reordering",
    "column reordering",
    "multi-drag",
    "multi-select",
    "virtual table",
    "virtualization",
    "touch",
    "mobile"
  ],
  "author": "Sami Odeh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samiodeh1337/react-table-dnd.git"
  },
  "homepage": "https://samiodeh1337.github.io/react-table-dnd/",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.13.22",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "highlight.js": "^11.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "lucide-react": "^1.48.0",
    "prettier": "^3.8.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "styled-components": "^6.4.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,html}": [
      "prettier --write"
    ]
  }
}
